# Copiá este archivo a .env y completá los valores.

# ── Backend real ─────────────────────────────────────────────────
# URL de la API (el proyecto agencia-viajes-backend). Si la dejás vacía, el sitio funciona en
# modo demo: los datos se guardan solo en este navegador y el login es de prueba.
# Local:        http://localhost:3000
# Producción:   https://api.tudominio.com
VITE_API_URL=http://localhost:3000

# ── Solo modo demo (sin backend) ─────────────────────────────────
# Cloudinary (subida de imágenes sin firmar): creá un "unsigned upload preset" en Cloudinary.
# Con el backend real NO hacen falta: las credenciales de Cloudinary van en el servidor.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Credenciales del login de DEMO.
VITE_ADMIN_EMAIL=admin@viajesconkaren.com
VITE_ADMIN_PASSWORD=admin1234
